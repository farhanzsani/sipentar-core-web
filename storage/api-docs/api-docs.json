{
    "openapi": "3.0.0",
    "info": {
        "title": "SIPENTAR API Documentation",
        "description": "API Documentation untuk Sistem Informasi Pertanian (SIPENTAR) - Aplikasi Manajemen Budidaya Hidroponik",
        "contact": {
            "name": "SIPENTAR Team"
        },
        "version": "1.0.0"
    },
    "servers": [
        {
            "url": "http://localhost:8000",
            "description": "Local Development Server"
        }
    ],
    "paths": {
        "/api/v1/auth/login": {
            "post": {
                "tags": [
                    "Authentication"
                ],
                "summary": "Login user",
                "description": "Authenticate user dengan username dan password. Return user data dan access token.",
                "operationId": "a7997e7c1e3bfed64d4e56de82415931",
                "requestBody": {
                    "required": true,
                    "content": {
                        "application/json": {
                            "schema": {
                                "required": [
                                    "username",
                                    "password"
                                ],
                                "properties": {
                                    "username": {
                                        "type": "string",
                                        "example": "admin"
                                    },
                                    "password": {
                                        "type": "string",
                                        "format": "password",
                                        "example": "admin123",
                                        "minLength": 8
                                    }
                                },
                                "type": "object"
                            }
                        }
                    }
                },
                "responses": {
                    "200": {
                        "description": "Login successful",
                        "content": {
                            "application/json": {
                                "schema": {
                                    "properties": {
                                        "success": {
                                            "type": "boolean",
                                            "example": true
                                        },
                                        "message": {
                                            "type": "string",
                                            "example": "Login berhasil."
                                        },
                                        "data": {
                                            "properties": {
                                                "user": {
                                                    "properties": {
                                                        "id": {
                                                            "type": "integer",
                                                            "example": 1
                                                        },
                                                        "nama": {
                                                            "type": "string",
                                                            "example": "Super Admin"
                                                        },
                                                        "username": {
                                                            "type": "string",
                                                            "example": "admin"
                                                        },
                                                        "role": {
                                                            "type": "string",
                                                            "example": "admin",
                                                            "enum": [
                                                                "admin",
                                                                "karyawan"
                                                            ]
                                                        }
                                                    },
                                                    "type": "object"
                                                },
                                                "token": {
                                                    "type": "string",
                                                    "example": "1|AbCdEfGhIjKlMnOpQrStUvWxYz"
                                                },
                                                "token_type": {
                                                    "type": "string",
                                                    "example": "Bearer"
                                                }
                                            },
                                            "type": "object"
                                        }
                                    },
                                    "type": "object"
                                }
                            }
                        }
                    },
                    "401": {
                        "description": "Invalid credentials",
                        "content": {
                            "application/json": {
                                "schema": {
                                    "properties": {
                                        "success": {
                                            "type": "boolean",
                                            "example": false
                                        },
                                        "message": {
                                            "type": "string",
                                            "example": "Username atau password salah."
                                        }
                                    },
                                    "type": "object"
                                }
                            }
                        }
                    },
                    "422": {
                        "description": "Validation error",
                        "content": {
                            "application/json": {
                                "schema": {
                                    "properties": {
                                        "success": {
                                            "type": "boolean",
                                            "example": false
                                        },
                                        "message": {
                                            "type": "string",
                                            "example": "Validation failed"
                                        },
                                        "errors": {
                                            "properties": {
                                                "username": {
                                                    "type": "array",
                                                    "items": {
                                                        "type": "string",
                                                        "example": "The username field is required."
                                                    }
                                                },
                                                "password": {
                                                    "type": "array",
                                                    "items": {
                                                        "type": "string",
                                                        "example": "The password must be at least 8 characters."
                                                    }
                                                }
                                            },
                                            "type": "object"
                                        }
                                    },
                                    "type": "object"
                                }
                            }
                        }
                    },
                    "429": {
                        "description": "Too many requests (Rate limit exceeded)",
                        "content": {
                            "application/json": {
                                "schema": {
                                    "properties": {
                                        "message": {
                                            "type": "string",
                                            "example": "Too Many Attempts."
                                        }
                                    },
                                    "type": "object"
                                }
                            }
                        }
                    }
                }
            }
        },
        "/api/v1/auth/logout": {
            "post": {
                "tags": [
                    "Authentication"
                ],
                "summary": "Logout user",
                "description": "Revoke current access token. User harus login ulang untuk mendapatkan token baru.",
                "operationId": "f6b8957b4c0b25636613a9f0512a8ba9",
                "responses": {
                    "200": {
                        "description": "Logout successful",
                        "content": {
                            "application/json": {
                                "schema": {
                                    "properties": {
                                        "success": {
                                            "type": "boolean",
                                            "example": true
                                        },
                                        "message": {
                                            "type": "string",
                                            "example": "Logout berhasil."
                                        }
                                    },
                                    "type": "object"
                                }
                            }
                        }
                    },
                    "401": {
                        "description": "Unauthenticated",
                        "content": {
                            "application/json": {
                                "schema": {
                                    "properties": {
                                        "success": {
                                            "type": "boolean",
                                            "example": false
                                        },
                                        "message": {
                                            "type": "string",
                                            "example": "Unauthenticated."
                                        }
                                    },
                                    "type": "object"
                                }
                            }
                        }
                    }
                },
                "security": [
                    {
                        "bearerAuth": []
                    }
                ]
            }
        },
        "/api/v1/keuangan/hpp": {
            "get": {
                "tags": [
                    "Keuangan"
                ],
                "summary": "Kalkulasi HPP (Harga Pokok Produksi) - Pemilik only",
                "operationId": "47a4f8b20f9bfa1c2b92141c30e2e421",
                "parameters": [
                    {
                        "name": "lubang",
                        "in": "query",
                        "description": "Jumlah lubang tanam",
                        "schema": {
                            "type": "integer",
                            "minimum": 1
                        }
                    },
                    {
                        "name": "panen_id",
                        "in": "query",
                        "description": "ID panen (lubang dari budidaya.jumlah_tanaman)",
                        "schema": {
                            "type": "integer"
                        }
                    }
                ],
                "responses": {
                    "200": {
                        "description": "Kalkulasi HPP berhasil",
                        "content": {
                            "application/json": {
                                "schema": {
                                    "properties": {
                                        "success": {
                                            "type": "boolean",
                                            "example": true
                                        },
                                        "message": {
                                            "type": "string"
                                        },
                                        "data": {
                                            "properties": {
                                                "lubang": {
                                                    "type": "integer",
                                                    "example": 100
                                                },
                                                "hpp_per_lubang": {
                                                    "type": "string",
                                                    "example": "1200"
                                                },
                                                "total_hpp": {
                                                    "type": "string",
                                                    "example": "120000.00"
                                                }
                                            },
                                            "type": "object"
                                        }
                                    },
                                    "type": "object"
                                }
                            }
                        }
                    },
                    "422": {
                        "description": "Validation error"
                    },
                    "403": {
                        "description": "Pegawai tidak memiliki akses"
                    }
                },
                "security": [
                    {
                        "bearerAuth": []
                    }
                ]
            }
        },
        "/api/v1/keuangan/alokasi-kas": {
            "get": {
                "tags": [
                    "Keuangan"
                ],
                "summary": "Alokasi kas operasional per tanggal (Pemilik only)",
                "operationId": "5a4421b6742c1de8a64d2454c73b32d6",
                "parameters": [
                    {
                        "name": "tanggal",
                        "in": "query",
                        "description": "Tanggal spesifik (YYYY-MM-DD)",
                        "required": true,
                        "schema": {
                            "type": "string",
                            "format": "date",
                            "example": "2026-11-22"
                        }
                    }
                ],
                "responses": {
                    "200": {
                        "description": "Data alokasi kas berhasil diambil",
                        "content": {
                            "application/json": {
                                "schema": {
                                    "properties": {
                                        "success": {
                                            "type": "boolean",
                                            "example": true
                                        },
                                        "message": {
                                            "type": "string"
                                        },
                                        "data": {
                                            "properties": {
                                                "tanggal": {
                                                    "type": "string",
                                                    "format": "date",
                                                    "example": "2026-11-22"
                                                },
                                                "total_pemasukan": {
                                                    "type": "string",
                                                    "example": "1500000.00"
                                                },
                                                "total_kas_operasional": {
                                                    "type": "string",
                                                    "example": "550000.00"
                                                }
                                            },
                                            "type": "object"
                                        }
                                    },
                                    "type": "object"
                                }
                            }
                        }
                    },
                    "422": {
                        "description": "Validation error"
                    },
                    "403": {
                        "description": "Pegawai tidak memiliki akses"
                    }
                },
                "security": [
                    {
                        "bearerAuth": []
                    }
                ]
            }
        },
        "/api/v1/keuangan/laporan": {
            "get": {
                "tags": [
                    "Keuangan"
                ],
                "summary": "Laporan keuangan per periode (Pemilik only)",
                "operationId": "88b6a881e69e3ec2dee5a6e20fb10b5d",
                "parameters": [
                    {
                        "name": "from",
                        "in": "query",
                        "description": "Tanggal mulai",
                        "required": true,
                        "schema": {
                            "type": "string",
                            "format": "date",
                            "example": "2026-11-01"
                        }
                    },
                    {
                        "name": "to",
                        "in": "query",
                        "description": "Tanggal akhir",
                        "required": true,
                        "schema": {
                            "type": "string",
                            "format": "date",
                            "example": "2026-11-30"
                        }
                    }
                ],
                "responses": {
                    "200": {
                        "description": "Laporan keuangan berhasil dibuat",
                        "content": {
                            "application/json": {
                                "schema": {
                                    "properties": {
                                        "success": {
                                            "type": "boolean",
                                            "example": true
                                        },
                                        "message": {
                                            "type": "string"
                                        },
                                        "data": {
                                            "properties": {
                                                "periode": {
                                                    "properties": {
                                                        "from": {
                                                            "type": "string",
                                                            "format": "date",
                                                            "example": "2026-11-01"
                                                        },
                                                        "to": {
                                                            "type": "string",
                                                            "format": "date",
                                                            "example": "2026-11-30"
                                                        }
                                                    },
                                                    "type": "object"
                                                },
                                                "total_pemasukan": {
                                                    "type": "string",
                                                    "example": "2000000.00"
                                                },
                                                "total_pengeluaran": {
                                                    "type": "string",
                                                    "example": "800000.00"
                                                },
                                                "total_kas_operasional": {
                                                    "type": "string",
                                                    "example": "700000.00"
                                                },
                                                "total_laba_bersih": {
                                                    "type": "string",
                                                    "example": "1300000.00"
                                                },
                                                "selisih": {
                                                    "description": "Pemasukan - Pengeluaran",
                                                    "type": "string",
                                                    "example": "1200000.00"
                                                }
                                            },
                                            "type": "object"
                                        }
                                    },
                                    "type": "object"
                                }
                            }
                        }
                    },
                    "422": {
                        "description": "Validation error"
                    },
                    "403": {
                        "description": "Pegawai tidak memiliki akses"
                    }
                },
                "security": [
                    {
                        "bearerAuth": []
                    }
                ]
            }
        },
        "/api/v1/transaksi-keuangan": {
            "get": {
                "tags": [
                    "Transaksi Keuangan"
                ],
                "summary": "Daftar transaksi keuangan (Pemilik only)",
                "operationId": "3ab7fb98bc0a3702ab3fa02fd9f228fd",
                "parameters": [
                    {
                        "name": "jenis",
                        "in": "query",
                        "description": "Filter berdasarkan jenis",
                        "schema": {
                            "type": "string",
                            "enum": [
                                "pemasukan",
                                "pengeluaran"
                            ]
                        }
                    },
                    {
                        "name": "from",
                        "in": "query",
                        "description": "Tanggal mulai (YYYY-MM-DD)",
                        "schema": {
                            "type": "string",
                            "format": "date"
                        }
                    },
                    {
                        "name": "to",
                        "in": "query",
                        "description": "Tanggal akhir (YYYY-MM-DD)",
                        "schema": {
                            "type": "string",
                            "format": "date"
                        }
                    },
                    {
                        "name": "per_page",
                        "in": "query",
                        "description": "Jumlah data per halaman",
                        "schema": {
                            "type": "integer",
                            "default": 15
                        }
                    }
                ],
                "responses": {
                    "200": {
                        "description": "Data berhasil diambil",
                        "content": {
                            "application/json": {
                                "schema": {
                                    "properties": {
                                        "success": {
                                            "type": "boolean",
                                            "example": true
                                        },
                                        "message": {
                                            "type": "string"
                                        },
                                        "data": {
                                            "type": "object"
                                        }
                                    },
                                    "type": "object"
                                }
                            }
                        }
                    },
                    "403": {
                        "description": "Pegawai tidak memiliki akses"
                    }
                },
                "security": [
                    {
                        "bearerAuth": []
                    }
                ]
            },
            "post": {
                "tags": [
                    "Transaksi Keuangan"
                ],
                "summary": "Catat transaksi keuangan baru (Pemilik only)",
                "operationId": "95f3aabad12076b707ba06186d54a2aa",
                "requestBody": {
                    "required": true,
                    "content": {
                        "application/json": {
                            "schema": {
                                "required": [
                                    "jenis",
                                    "tanggal",
                                    "jumlah"
                                ],
                                "properties": {
                                    "jenis": {
                                        "type": "string",
                                        "example": "pemasukan",
                                        "enum": [
                                            "pemasukan",
                                            "pengeluaran"
                                        ]
                                    },
                                    "tanggal": {
                                        "type": "string",
                                        "format": "date",
                                        "example": "2026-11-22"
                                    },
                                    "jumlah": {
                                        "type": "number",
                                        "format": "decimal",
                                        "example": 1000000
                                    },
                                    "persentase_kas": {
                                        "description": "Wajib untuk pemasukan (30-40)",
                                        "type": "number",
                                        "format": "decimal",
                                        "example": 35
                                    },
                                    "panen_id": {
                                        "type": "integer",
                                        "example": 1
                                    },
                                    "keterangan": {
                                        "type": "string",
                                        "example": "Penjualan panen November"
                                    }
                                },
                                "type": "object"
                            }
                        }
                    }
                },
                "responses": {
                    "201": {
                        "description": "Transaksi berhasil dibuat. Server auto-calculate kas_operasional & laba_bersih"
                    },
                    "422": {
                        "description": "Validation error"
                    },
                    "403": {
                        "description": "Pegawai tidak memiliki akses"
                    }
                },
                "security": [
                    {
                        "bearerAuth": []
                    }
                ]
            }
        },
        "/api/v1/transaksi-keuangan/{id}": {
            "get": {
                "tags": [
                    "Transaksi Keuangan"
                ],
                "summary": "Detail transaksi keuangan (Pemilik only)",
                "operationId": "0554396661acafa79a182617e1ca5416",
                "parameters": [
                    {
                        "name": "id",
                        "in": "path",
                        "required": true,
                        "schema": {
                            "type": "integer"
                        }
                    }
                ],
                "responses": {
                    "200": {
                        "description": "Data berhasil diambil"
                    },
                    "404": {
                        "description": "Transaksi tidak ditemukan"
                    },
                    "403": {
                        "description": "Pegawai tidak memiliki akses"
                    }
                },
                "security": [
                    {
                        "bearerAuth": []
                    }
                ]
            },
            "put": {
                "tags": [
                    "Transaksi Keuangan"
                ],
                "summary": "Update transaksi keuangan dengan recalculation (Pemilik only)",
                "operationId": "13dba9e90964297143b2584d53aec050",
                "parameters": [
                    {
                        "name": "id",
                        "in": "path",
                        "required": true,
                        "schema": {
                            "type": "integer"
                        }
                    }
                ],
                "requestBody": {
                    "required": true,
                    "content": {
                        "application/json": {
                            "schema": {
                                "required": [
                                    "jenis",
                                    "tanggal",
                                    "jumlah"
                                ],
                                "properties": {
                                    "jenis": {
                                        "type": "string",
                                        "enum": [
                                            "pemasukan",
                                            "pengeluaran"
                                        ]
                                    },
                                    "tanggal": {
                                        "type": "string",
                                        "format": "date"
                                    },
                                    "jumlah": {
                                        "type": "number",
                                        "format": "decimal"
                                    },
                                    "persentase_kas": {
                                        "type": "number",
                                        "format": "decimal"
                                    },
                                    "panen_id": {
                                        "type": "integer"
                                    },
                                    "keterangan": {
                                        "type": "string"
                                    }
                                },
                                "type": "object"
                            }
                        }
                    }
                },
                "responses": {
                    "200": {
                        "description": "Transaksi berhasil diperbarui dengan recalculation"
                    },
                    "404": {
                        "description": "Transaksi tidak ditemukan"
                    },
                    "422": {
                        "description": "Validation error"
                    },
                    "403": {
                        "description": "Pegawai tidak memiliki akses"
                    }
                },
                "security": [
                    {
                        "bearerAuth": []
                    }
                ]
            }
        }
    },
    "components": {
        "securitySchemes": {
            "bearerAuth": {
                "type": "http",
                "bearerFormat": "JWT",
                "scheme": "bearer"
            }
        }
    },
    "tags": [
        {
            "name": "Authentication",
            "description": "Authentication"
        },
        {
            "name": "Keuangan",
            "description": "Keuangan"
        },
        {
            "name": "Transaksi Keuangan",
            "description": "Transaksi Keuangan"
        }
    ]
}